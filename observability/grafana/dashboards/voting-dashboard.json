{
  "uid": "bbb-voting",
  "title": "BBB Voting - Vote SLO",
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 3,
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "SLI - Vote Success Rate (%)",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "(votes_accepted_total / vote_requests_total) * 100",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "type": "stat",
      "title": "SLO - Vote Success 99%",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "(votes_accepted_total / vote_requests_total) * 100",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 99 },
              { "color": "green", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Vote Success Rate Over Time (%)",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "(votes_accepted_total / vote_requests_total) * 100",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    }
  ]
}
