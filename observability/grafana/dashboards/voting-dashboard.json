{
  "uid": "bbb-voting",
  "title": "BBB Voting - Voting Metrics",
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Accepted Votes Over Time",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "increase(votes_accepted_total[5m])", "refId": "A" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "timeseries",
      "title": "Rejected Votes Over Time",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "increase(votes_rejected_total[5m])", "refId": "A" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "gauge",
      "title": "Acceptance Ratio",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 6 },
      "targets": [
        { "expr": "votes_accepted_total / vote_requests_total", "refId": "A" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    }
  ]
}
